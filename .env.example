# Скопируйте в .env и заполните пустые значения: cp .env.example .env
# Значения по умолчанию рассчитаны на локальную разработку: внешние побочные эффекты
# (письма, возвраты, зачисления на медсчёт, опрос МИС) выключены.

# --- Сервер ---
NODE_ENV=development
PORT=4000
# Через запятую. Пусто — http://localhost:3000, http://localhost:5173
CORS_ORIGIN=
LOG_LEVEL=debug
LOG_PRETTY=true

# --- База и Redis ---
# Для запуска из терминала (npm run dev) при базе из docker compose.
# docker-compose.dev.yml перекрывает оба значения на db:5432 и redis.
# `!` в пароле закодирован как %21.
DATABASE_URL=postgresql://postgres:Passqqaazz%211@localhost:5433/archimedes
REDIS_HOST=localhost

# --- Шифрование и токены ---
# openssl rand -hex 32
# Для базы с реальными данными ключ должен совпадать с тем, которым они зашифрованы.
FIELD_ENCRYPTION_KEY=
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d

PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# --- Админ дашборда (читается только npm run db:create-admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# --- МИС ---
# Внутренние хосты: доступны только из сети клиники / через VPN.
MIS_API_URL=
MIS_DEV_API_URL=
MIS_API_PREFIX=
MIS_APPOINTMENT_SYNC_ENABLED=false
MIS_APPOINTMENT_SYNC_INTERVAL_SECONDS=900
MIS_APPOINTMENT_SYNC_BATCH_SIZE=25
MIS_APPOINTMENT_SYNC_SPACING_MS=300
MIS_APPOINTMENT_SYNC_LOOKBACK_DAYS=7
MIS_APPOINTMENT_SYNC_HOT_HORIZON_HOURS=48
MIS_APPOINTMENT_SYNC_COLD_INTERVAL_HOURS=24

# --- Страховая ---
INSURANCE_SERVICE_API_URL=
INSURANCE_SERVICE_DEV_API_URL=
INSURANCE_TEST_ID=

# --- SMS (вне production OTP возвращается в ответе /auth, SMS не нужна) ---
SMS_SERVICE_API_URL=
SMS_SERVICE_USERNAME=
SMS_SERVICE_PASSWORD=
SMS_SERVICE_ORIGINATOR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Демо-аккаунт ---
DEMO_ACCOUNT_PHONE=
DEMO_ACCOUNT_IIN=
DEMO_ACCOUNT_OTP=
DEMO_MIS_ACCOUNT_IIN=
DEMO_MIS_ACCOUNT_PHONE=

# --- Уведомления (OneSignal) ---
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_AUTH_KEY=
# true — напоминания через 30/60 секунд после записи, а не за 3/1 час до приёма
NOTIFICATION_TEST_MODE=false

# --- Zoom (телемедицина) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_TOKEN_URL=https://zoom.us/oauth/token
ZOOM_API_URL=https://api.zoom.us/v2
# Код услуги, который уходит в МИС как booked_service для любой телемед-записи
TELEMEDICINE_SERVICE_CODE=A02.083.000
# Цена платной онлайн-консультации, ₸ (сумма /payment/init проверяется по ней)
TELEMEDICINE_PRICE=6000
# Подстроки названий специальностей, скрытых в телемедицине, через запятую (без учёта регистра)
TELEMEDICINE_EXCLUDED_SPECIALTIES=УЗИ,МАССАЖ,СТОМАТОЛОГ,ВЫЕЗДН,ПСИХОЛОГ,РЕНТГЕН

# --- Почта (заявки на платные программы) ---
MAIL_ENABLED=false
SMTP_HOST=mail.archimedes.kz
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=false
MAIL_FROM=Archimedes App <no-reply@archimedes.kz>
# Через запятую
PROGRAM_ORDER_EMAIL_TO=

# --- FreedomPay ---
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_API_URL=https://api.freedompay.kz
FREEDOMPAY_CALLBACK_URL=
FREEDOMPAY_SUCCESS_URL=
FREEDOMPAY_FAILURE_URL=
# Платежи создаются в песочнице, реальные деньги не двигаются
FREEDOMPAY_TESTING_MODE=true
FREEDOMPAY_LIFETIME_SECONDS=1800
FREEDOMPAY_RECONCILE_INTERVAL_SECONDS=60
FREEDOMPAY_RECONCILE_BATCH_SIZE=20
FREEDOMPAY_RECONCILE_SPACING_MS=1500
FREEDOMPAY_RECONCILE_MAX_AGE_MINUTES=60

# --- Отмена приёмов и возвраты ---
APPOINTMENT_REFUND_ENABLED=false
APPOINTMENT_REFUND_FULL_WINDOW_HOURS=12
APPOINTMENT_LATE_CANCELLATION_FEE_PERCENT=30

# --- Медсчёт ---
MED_ACCOUNT_CREDIT_ENABLED=false

# --- Фискализация (Webkassa) ---
# Чеки продажи/возврата пробиваются фоновой очередью `webkassa`. С false строки чеков
# создаются (PENDING), но в Webkassa ничего не уходит.
WEBKASSA_ENABLED=false
WEBKASSA_API_URL=https://devkkm.webkassa.kz
# Секреты: API-ключ и учётка кассира. Только в .env, никогда в git и в логах.
WEBKASSA_API_KEY=
WEBKASSA_LOGIN=
WEBKASSA_PASSWORD=
# ЗНК кассы — не секрет. SWK00035676 — тестовая касса devkkm.
WEBKASSA_CASHBOX_UNIQUE_NUMBER=SWK00035676
WEBKASSA_FISCALIZE_PURPOSES=APPOINTMENT,PAID_PROGRAM,MED_ACCOUNT_TOPUP
# 100 — НДС (клиника — плательщик НДС, 16%), 0 — без НДС
WEBKASSA_TAX_TYPE=100
WEBKASSA_TAX_PERCENT=16
# 1 — банковская карта
WEBKASSA_PAYMENT_TYPE=1
WEBKASSA_SEND_CUSTOMER_PHONE=true
# Ежедневный Z-отчёт, часовой пояс Asia/Almaty. Пусто — расписание снимается.
WEBKASSA_SHIFT_CLOSE_CRON=55 23 * * *
WEBKASSA_TOKEN_TTL_MINUTES=600
WEBKASSA_MAX_ATTEMPTS=8
WEBKASSA_SWEEP_INTERVAL_SECONDS=300

# --- Прочее ---
SENTRY_DSN=
APP_VERSION_IOS_URL=
APP_VERSION_ANDROID_URL=
