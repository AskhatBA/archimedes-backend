generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id               String  @id @default(uuid()) @db.Uuid
  phone            String  @unique
  email            String? @unique
  refreshTokenHash String?
  tokenVersion     Int     @default(0)
  role             Role    @default(PATIENT)
  balance          Float   @default(0)

  // Set only for dashboard admins — mobile users authenticate by OTP/PIN and leave this null.
  passwordHash String?

  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  biometricEnabled  Boolean   @default(false)

  patient                 Patient?
  doctor                  Doctor?
  otp                     OTP?
  insuranceServiceToken   InsuranceServiceToken?
  deviceTokens            DeviceToken[]
  appointments            Appointment[]
  notifications           Notification[]
  insuranceRefundRequests InsuranceRefundRequest[]
  payments                Payment[]
  auditLogs               AuditLog[]
}

model Patient {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @unique @db.Uuid
  firstName    String
  lastName     String
  patronymic   String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  birthDate    String
  gender       String
  iin          String @unique
  misPatientId String @unique
}

model Doctor {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  firstName      String
  lastName       String
  patronymic     String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  specialization String
  licenseNumber  String  @unique
  phone          String?
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  patientId      String            @db.Uuid
  doctorId       String            @db.Uuid
  externalId     String            @db.Uuid
  dateTime       DateTime
  status         AppointmentStatus @default(SCHEDULED)
  isTelemedicine Boolean           @default(false)
  meetingUrl     String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTP {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model InsuranceServiceToken {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  accessToken String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InsuranceRefundRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  beneficiaryId    String
  personId         String
  programId        String
  category         Int
  date             String
  amount           Float
  comments         String?
  files            Json
  externalResponse Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum AppVersionPlatform {
  IOS
  ANDROID
  ALL
}

model AppVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  platform            AppVersionPlatform
  latestVersion       String
  minSupportedVersion String
  forceUpdate         Boolean            @default(false)
  changelog           String?
  createdAt           DateTime           @default(now())

  @@index([platform, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// What the payment is for. Drives which post-success handler runs when it settles.
enum PaymentPurpose {
  BALANCE_TOPUP
  APPOINTMENT
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  amount           Float
  description      String
  status           PaymentStatus  @default(PENDING)
  purpose          PaymentPurpose @default(BALANCE_TOPUP)
  /// Payload the post-success handler for `purpose` needs, validated at init time.
  metadata         Json?
  /// Why the post-success handler failed, if it did — the payment went through but what
  /// it was for did not happen.
  postSuccessError String?
  pgPaymentId      String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

enum AuditEvent {
  AUTH_OTP_REQUEST
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_TOKEN_REFRESHED
  AUTH_REFRESH_FAILED
  AUTH_PIN_VERIFY_SUCCESS
  AUTH_PIN_VERIFY_FAILED
  AUTH_PIN_LOCKED
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_LOGIN_THROTTLED
  USER_ACCOUNT_CREATED
  USER_PHONE_CHANGED
  USER_PROFILE_CREATED
  USER_PIN_SET
  USER_BIOMETRIC_ENABLED
  USER_BIOMETRIC_DISABLED
  APPOINTMENT_ACCESS_DENIED
  APPOINTMENT_CONFLICT
  APPOINTMENT_LIST_VIEWED
  APPOINTMENT_VIEWED
  APPOINTMENT_HISTORY_VIEWED
  APPOINTMENT_REQUESTS_VIEWED
  PROFILE_VIEWED
  REFUND_REQUESTED
  REFUND_REQUESTS_VIEWED
  REFUND_ACCESS_DENIED
  PATIENT_LIST_VIEWED
  CHECKUP_CREATED
  CHECKUP_UPDATED
  CHECKUP_DELETED
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  event     AuditEvent
  success   Boolean
  userId    String?    @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([phone])
  @@index([createdAt])
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  title             String
  message           String
  data              Json?
  status            NotificationStatus @default(SENT)
  isRead            Boolean            @default(false)
  readAt            DateTime?
  oneSignalId       String?
  oneSignalResponse Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, isRead])
}

enum CheckupCoverage {
  PERSONAL
  FAMILY
}

/// Check-up catalogue for the mobile app's "Чек-ап" tab. Unlike med plans, which the
/// MIS owns and we only proxy, these programs are ours: they are seeded from the
/// clinic's price list (`npm run db:seed-checkups`) and edited in the database.
model Checkup {
  id          String          @id @default(uuid()) @db.Uuid
  /// Stable slug the seed upserts on, e.g. `thyroid`. Ids are free to change, this is not.
  code        String          @unique
  title       String
  /// Optional intro paragraph above the service list — the app hides it when empty.
  description String?
  /// Price in tenge.
  price       Int
  /// How long the program runs, e.g. "1 день". Hidden by the app when unknown.
  duration    String?
  coverage    CheckupCoverage @default(PERSONAL)
  /// What the program includes, rendered as a checklist in the details drawer.
  services    String[]
  popular     Boolean         @default(false)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive, sortOrder])
}
