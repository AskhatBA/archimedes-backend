generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id               String  @id @default(uuid()) @db.Uuid
  phone            String  @unique
  email            String? @unique
  refreshTokenHash String?
  tokenVersion     Int     @default(0)
  role             Role    @default(PATIENT)
  balance          Float   @default(0)

  // Set only for dashboard admins — mobile users authenticate by OTP/PIN and leave this null.
  passwordHash String?

  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  biometricEnabled  Boolean   @default(false)

  patient                 Patient?
  doctor                  Doctor?
  otp                     OTP?
  insuranceServiceToken   InsuranceServiceToken?
  deviceTokens            DeviceToken[]
  appointments            Appointment[]
  notifications           Notification[]
  insuranceRefundRequests InsuranceRefundRequest[]
  payments                Payment[]
  auditLogs               AuditLog[]
  programOrders           ProgramOrder[]
  medAccountTopups        MedAccountTopup[]
  appointmentRefunds      AppointmentRefund[]
}

model Patient {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @unique @db.Uuid
  firstName    String
  lastName     String
  patronymic   String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  birthDate    String
  gender       String
  iin          String @unique
  misPatientId String @unique
}

model Doctor {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  firstName      String
  lastName       String
  patronymic     String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  specialization String
  licenseNumber  String  @unique
  phone          String?
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  patientId      String             @db.Uuid
  doctorId       String             @db.Uuid
  externalId     String             @db.Uuid
  dateTime       DateTime
  status         AppointmentStatus  @default(SCHEDULED)
  /// Raw MIS status string the sync last saw, kept as-is: MIS has more states than our
  /// three (`in_progress`, `pending`, `rejected`...), and the operator wants to see them.
  misStatus      String?
  /// When the status sync last managed to reach MIS about this visit. Null means never —
  /// those go first, so a freshly booked visit is confirmed before an old one is re-checked.
  statusSyncedAt DateTime?
  isTelemedicine Boolean            @default(false)
  meetingUrl     String?
  notes          String?
  /// The settled payment that bought this visit, for a patient paying per booking. Null
  /// means the visit went through an insurance programme and there is no money of ours
  /// behind it — which is what decides whether cancelling owes a refund.
  paymentId      String?            @unique @db.Uuid
  /// When the patient cancelled. Kept apart from `updatedAt`, which any sync pass moves.
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refund         AppointmentRefund?

  @@index([userId])
  // The sync sweep looks up open visits by status and date on every run.
  @@index([status, dateTime])
}

model OTP {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model InsuranceServiceToken {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  accessToken String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InsuranceRefundRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  beneficiaryId    String
  personId         String
  programId        String
  category         Int
  date             String
  amount           Float
  comments         String?
  files            Json
  externalResponse Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum AppVersionPlatform {
  IOS
  ANDROID
  ALL
}

model AppVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  platform            AppVersionPlatform
  latestVersion       String
  minSupportedVersion String
  forceUpdate         Boolean            @default(false)
  changelog           String?
  createdAt           DateTime           @default(now())

  @@index([platform, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  /// The payer walked away from the provider's page and said so. Terminal for us, but
  /// not for FreedomPay — a one-step payment has nothing to cancel on their side, so a
  /// payment that settles after this is still honoured.
  CANCELLED
}

/// What the payment is for. Drives which post-success handler runs when it settles.
enum PaymentPurpose {
  BALANCE_TOPUP
  APPOINTMENT
  /// A paid-programs cart (med plans and/or check-ups) bought from the mobile app.
  PAID_PROGRAM
  /// A top-up of the patient's medical account ("медсчёт"), from a fixed amount they picked.
  MED_ACCOUNT_TOPUP
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  amount            Float
  description       String
  status            PaymentStatus      @default(PENDING)
  purpose           PaymentPurpose     @default(BALANCE_TOPUP)
  /// Payload the post-success handler for `purpose` needs, validated at init time.
  metadata          Json?
  /// Why the post-success handler failed, if it did — the payment went through but what
  /// it was for did not happen.
  postSuccessError  String?
  pgPaymentId       String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set only for `PAID_PROGRAM` payments — the order its success handler created.
  programOrder      ProgramOrder?
  /// Set only for `MED_ACCOUNT_TOPUP` payments — the top-up its success handler recorded.
  medAccountTopup   MedAccountTopup?
  /// Set only for `APPOINTMENT` payments — the visit its success handler booked.
  appointment       Appointment?
  /// Refund of this payment, when the visit it paid for was cancelled.
  appointmentRefund AppointmentRefund?

  @@index([userId])
  @@index([createdAt])
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

enum AuditEvent {
  AUTH_OTP_REQUEST
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_TOKEN_REFRESHED
  AUTH_REFRESH_FAILED
  AUTH_PIN_VERIFY_SUCCESS
  AUTH_PIN_VERIFY_FAILED
  AUTH_PIN_LOCKED
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_LOGIN_THROTTLED
  USER_ACCOUNT_CREATED
  USER_PHONE_CHANGED
  USER_PROFILE_CREATED
  USER_PIN_SET
  USER_BIOMETRIC_ENABLED
  USER_BIOMETRIC_DISABLED
  APPOINTMENT_ACCESS_DENIED
  APPOINTMENT_CONFLICT
  APPOINTMENT_LIST_VIEWED
  APPOINTMENT_VIEWED
  APPOINTMENT_HISTORY_VIEWED
  APPOINTMENT_REQUESTS_VIEWED
  PROFILE_VIEWED
  REFUND_REQUESTED
  REFUND_REQUESTS_VIEWED
  REFUND_ACCESS_DENIED
  PATIENT_LIST_VIEWED
  CHECKUP_CREATED
  CHECKUP_UPDATED
  CHECKUP_DELETED
  PROGRAM_ORDER_CREATED
  PROGRAM_ORDER_STATUS_CHANGED
  APPOINTMENT_STATUS_SYNCED
  MED_ACCOUNT_TOPUP_OPTION_CREATED
  MED_ACCOUNT_TOPUP_OPTION_UPDATED
  MED_ACCOUNT_TOPUP_OPTION_DELETED
  MED_ACCOUNT_TOPUP_CREATED
  MED_ACCOUNT_TOPUP_CREDITED
  MED_ACCOUNT_TOPUP_STATUS_CHANGED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REFUND_CREATED
  APPOINTMENT_REFUND_PROCESSED
  APPOINTMENT_REFUND_STATUS_CHANGED
  PATIENT_PROFILE_UPDATED
  PATIENT_PROFILE_DELETED
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  event     AuditEvent
  success   Boolean
  userId    String?    @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([phone])
  @@index([createdAt])
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  title             String
  message           String
  data              Json?
  status            NotificationStatus @default(SENT)
  isRead            Boolean            @default(false)
  readAt            DateTime?
  oneSignalId       String?
  oneSignalResponse Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, isRead])
}

enum CheckupCoverage {
  PERSONAL
  FAMILY
}

/// Check-up catalogue for the mobile app's "Чек-ап" tab. Unlike med plans, which the
/// MIS owns and we only proxy, these programs are ours: they are seeded from the
/// clinic's price list (`npm run db:seed-checkups`) and edited in the database.
model Checkup {
  id          String          @id @default(uuid()) @db.Uuid
  /// Stable slug the seed upserts on, e.g. `thyroid`. Ids are free to change, this is not.
  code        String          @unique
  title       String
  /// Optional intro paragraph above the service list — the app hides it when empty.
  description String?
  /// Price in tenge.
  price       Int
  /// How long the program runs, e.g. "1 день". Hidden by the app when unknown.
  duration    String?
  coverage    CheckupCoverage @default(PERSONAL)
  /// What the program includes, rendered as a checklist in the details drawer.
  services    String[]
  popular     Boolean         @default(false)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

/// Where an operator has got to with a paid-programs order.
enum ProgramOrderStatus {
  /// Paid, nobody has picked it up yet.
  NEW
  /// An operator is working it — the patient has been contacted, a date is being agreed.
  IN_PROGRESS
  /// The program has been issued / the check-up has taken place.
  COMPLETED
  CANCELLED
}

/// Which catalogue an ordered program came from. Mirrors the mobile app's two tabs.
enum ProgramOrderCategory {
  /// Med plan proxied from the MIS (`GET /insurance/pay-programs`).
  MED_PLAN
  /// Our own check-up catalogue (`Checkup`).
  CHECKUP
}

/// A paid-programs order ("заявка"): what the patient bought from the paid-programs
/// screen, recorded once the payment behind it settles as SUCCESS.
///
/// Created by the `PAID_PROGRAM` payment purpose handler, never by a request from the
/// app — an order exists only if the money moved. `paymentId` is unique, which is what
/// makes the handler idempotent: a replayed provider callback cannot duplicate the order.
model ProgramOrder {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  /// The settled payment this order was paid by — one order per payment.
  paymentId    String             @unique @db.Uuid
  status       ProgramOrderStatus @default(NEW)
  /// Amount actually paid, in tenge. Kept here so the order reads on its own.
  total        Float
  /// Phone to call the patient back on, copied from the account at order time.
  contactPhone String?
  /// Free-form note an operator leaves while working the order.
  comment      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  items   ProgramOrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// One program inside an order, snapshotted at purchase time — titles and prices in the
/// catalogue keep changing, an order must not.
model ProgramOrderItem {
  id         String               @id @default(uuid()) @db.Uuid
  orderId    String               @db.Uuid
  category   ProgramOrderCategory
  /// Catalogue id at purchase time: the MIS `oid` for a med plan, `Checkup.id` for a check-up.
  externalId String
  /// Catalogue code, e.g. `M2` for a med plan or the `thyroid` slug for a check-up.
  code       String?
  title      String
  /// Price in tenge at purchase time.
  price      Float

  order ProgramOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// One selectable amount on the mobile app's "пополнить медсчёт" screen.
///
/// The patient picks exactly one of these and is sent straight to payment, so the row is
/// the whole offer: there is no cart and no free-form amount. The dashboard owns the list.
model MedAccountTopupOption {
  id        String   @id @default(uuid()) @db.Uuid
  /// Amount in tenge. Unique — the screen is a set of distinct amounts, and a duplicate
  /// is an editing mistake rather than a second offer.
  amount    Int      @unique
  /// Optional caption under the amount, e.g. "Хватит на приём терапевта". Hidden when empty.
  label     String?
  /// Draws the "выгодно" badge on the card. Purely presentational.
  popular   Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topups MedAccountTopup[]

  @@index([isActive, sortOrder])
}

/// How far a paid top-up has got on its way onto the patient's medical account.
enum MedAccountTopupStatus {
  /// Paid, not yet on the medical account. Every top-up starts here.
  PENDING
  /// The money is on the account — credited by the insurer's API, or by an operator by hand.
  CREDITED
  /// The insurer refused the transfer. Needs an operator; the money has already been taken.
  FAILED
}

/// A top-up the patient has actually paid for.
///
/// Written by the `MED_ACCOUNT_TOPUP` post-success handler, so a row here always has money
/// behind it. The medical account itself lives in the insurer's system and we have no
/// endpoint to credit it yet, which is why the row carries its own status: until that
/// endpoint exists, the dashboard is the record that the money arrived and an operator
/// moves the row to CREDITED after posting it on their side.
model MedAccountTopup {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  /// The settled payment behind it. Unique, so a replayed provider callback or the
  /// reconciliation sweep cannot record the same top-up twice.
  paymentId     String                @unique @db.Uuid
  /// The catalogue entry the patient picked; nulled if that amount is later removed.
  optionId      String?               @db.Uuid
  /// Amount actually paid, in tenge. Snapshotted so the row reads on its own.
  amount        Int
  status        MedAccountTopupStatus @default(PENDING)
  /// Insurer beneficiary the money is for, resolved from MIS at payment time. The credit
  /// call needs it, and it is what an operator searches the insurer's system by.
  beneficiaryId String?
  /// Reference the insurer returned when it accepted the transfer, once that API exists.
  externalRef   String?
  /// Why the credit failed, or the operator's own note.
  comment       String?
  /// When the money reached the medical account.
  creditedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  option  MedAccountTopupOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// How far a refund for a cancelled paid visit has got with FreedomPay.
enum AppointmentRefundStatus {
  /// Owed to the patient, not yet sent to the provider. Every refund starts here.
  PENDING
  /// FreedomPay accepted the reversal.
  COMPLETED
  /// FreedomPay refused it, or we never managed to ask. Needs an operator — the patient
  /// has been charged and their visit is already cancelled.
  FAILED
}

/// The money owed back for a paid visit the patient cancelled.
///
/// Written the moment the visit is cancelled, before FreedomPay is asked: the cancellation
/// has already happened and the debt exists whether or not the provider is reachable.
/// `appointmentId` is unique, so a double-tapped cancel cannot owe the same money twice.
///
/// The row also records *why* the amount is what it is: cancelling at least
/// `APPOINTMENT_REFUND_FULL_WINDOW_HOURS` before the visit returns everything, later than
/// that keeps a `feePercent` compensation, and `hoursBeforeAppointment` is the number the
/// decision was made on — none of which can be recomputed later, since `now` has moved.
model AppointmentRefund {
  id            String                  @id @default(uuid()) @db.Uuid
  appointmentId String                  @unique @db.Uuid
  /// The payment being reversed. Unique — one refund per payment, so a replayed
  /// cancellation cannot revoke the same charge twice.
  paymentId     String                  @unique @db.Uuid
  userId        String                  @db.Uuid
  /// What the visit cost, in tenge. Snapshotted so the row reads on its own.
  paidAmount    Float
  /// Share of `paidAmount` being returned: 100 outside the free window, 100 - fee inside it.
  refundPercent Int
  /// What the patient gets back, in tenge — this is the `pg_refund_amount` sent.
  amount        Float
  /// Compensation kept by the clinic for a late cancellation. `paidAmount - amount`.
  feeAmount     Float
  /// Hours between the cancellation and the visit, as measured when it was cancelled.
  hoursBefore   Float
  status        AppointmentRefundStatus @default(PENDING)
  /// Whatever reference FreedomPay handed back for the reversal.
  externalRef   String?
  /// Why the refund failed, or the operator's own note.
  comment       String?
  /// When FreedomPay accepted it.
  refundedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}
