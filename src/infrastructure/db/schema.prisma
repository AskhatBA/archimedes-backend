generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model User {
  id               String  @id @default(uuid()) @db.Uuid
  phone            String  @unique
  email            String? @unique
  refreshTokenHash String?
  tokenVersion     Int     @default(0)
  role             Role    @default(PATIENT)
  balance          Float   @default(0)

  // Set only for dashboard admins — mobile users authenticate by OTP/PIN and leave this null.
  passwordHash String?

  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  biometricEnabled  Boolean   @default(false)

  patient                 Patient?
  doctor                  Doctor?
  otp                     OTP?
  insuranceServiceToken   InsuranceServiceToken?
  deviceTokens            DeviceToken[]
  appointments            Appointment[]
  notifications           Notification[]
  insuranceRefundRequests InsuranceRefundRequest[]
  payments                Payment[]
  auditLogs               AuditLog[]
  programOrders           ProgramOrder[]
}

model Patient {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @unique @db.Uuid
  firstName    String
  lastName     String
  patronymic   String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  birthDate    String
  gender       String
  iin          String @unique
  misPatientId String @unique
}

model Doctor {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  firstName      String
  lastName       String
  patronymic     String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  specialization String
  licenseNumber  String  @unique
  phone          String?
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  patientId      String            @db.Uuid
  doctorId       String            @db.Uuid
  externalId     String            @db.Uuid
  dateTime       DateTime
  status         AppointmentStatus @default(SCHEDULED)
  /// Raw MIS status string the sync last saw, kept as-is: MIS has more states than our
  /// three (`in_progress`, `pending`, `rejected`...), and the operator wants to see them.
  misStatus      String?
  /// When the status sync last managed to reach MIS about this visit. Null means never —
  /// those go first, so a freshly booked visit is confirmed before an old one is re-checked.
  statusSyncedAt DateTime?
  isTelemedicine Boolean           @default(false)
  meetingUrl     String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The sync sweep looks up open visits by status and date on every run.
  @@index([status, dateTime])
}

model OTP {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model InsuranceServiceToken {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  accessToken String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InsuranceRefundRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  beneficiaryId    String
  personId         String
  programId        String
  category         Int
  date             String
  amount           Float
  comments         String?
  files            Json
  externalResponse Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum AppVersionPlatform {
  IOS
  ANDROID
  ALL
}

model AppVersion {
  id                  String             @id @default(uuid()) @db.Uuid
  platform            AppVersionPlatform
  latestVersion       String
  minSupportedVersion String
  forceUpdate         Boolean            @default(false)
  changelog           String?
  createdAt           DateTime           @default(now())

  @@index([platform, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  deviceId  String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  /// The payer walked away from the provider's page and said so. Terminal for us, but
  /// not for FreedomPay — a one-step payment has nothing to cancel on their side, so a
  /// payment that settles after this is still honoured.
  CANCELLED
}

/// What the payment is for. Drives which post-success handler runs when it settles.
enum PaymentPurpose {
  BALANCE_TOPUP
  APPOINTMENT
  /// A paid-programs cart (med plans and/or check-ups) bought from the mobile app.
  PAID_PROGRAM
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  amount           Float
  description      String
  status           PaymentStatus  @default(PENDING)
  purpose          PaymentPurpose @default(BALANCE_TOPUP)
  /// Payload the post-success handler for `purpose` needs, validated at init time.
  metadata         Json?
  /// Why the post-success handler failed, if it did — the payment went through but what
  /// it was for did not happen.
  postSuccessError String?
  pgPaymentId      String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set only for `PAID_PROGRAM` payments — the order its success handler created.
  programOrder     ProgramOrder?

  @@index([userId])
  @@index([createdAt])
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

enum AuditEvent {
  AUTH_OTP_REQUEST
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_TOKEN_REFRESHED
  AUTH_REFRESH_FAILED
  AUTH_PIN_VERIFY_SUCCESS
  AUTH_PIN_VERIFY_FAILED
  AUTH_PIN_LOCKED
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_LOGIN_THROTTLED
  USER_ACCOUNT_CREATED
  USER_PHONE_CHANGED
  USER_PROFILE_CREATED
  USER_PIN_SET
  USER_BIOMETRIC_ENABLED
  USER_BIOMETRIC_DISABLED
  APPOINTMENT_ACCESS_DENIED
  APPOINTMENT_CONFLICT
  APPOINTMENT_LIST_VIEWED
  APPOINTMENT_VIEWED
  APPOINTMENT_HISTORY_VIEWED
  APPOINTMENT_REQUESTS_VIEWED
  PROFILE_VIEWED
  REFUND_REQUESTED
  REFUND_REQUESTS_VIEWED
  REFUND_ACCESS_DENIED
  PATIENT_LIST_VIEWED
  CHECKUP_CREATED
  CHECKUP_UPDATED
  CHECKUP_DELETED
  PROGRAM_ORDER_CREATED
  PROGRAM_ORDER_STATUS_CHANGED
  APPOINTMENT_STATUS_SYNCED
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  event     AuditEvent
  success   Boolean
  userId    String?    @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([phone])
  @@index([createdAt])
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  title             String
  message           String
  data              Json?
  status            NotificationStatus @default(SENT)
  isRead            Boolean            @default(false)
  readAt            DateTime?
  oneSignalId       String?
  oneSignalResponse Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, isRead])
}

enum CheckupCoverage {
  PERSONAL
  FAMILY
}

/// Check-up catalogue for the mobile app's "Чек-ап" tab. Unlike med plans, which the
/// MIS owns and we only proxy, these programs are ours: they are seeded from the
/// clinic's price list (`npm run db:seed-checkups`) and edited in the database.
model Checkup {
  id          String          @id @default(uuid()) @db.Uuid
  /// Stable slug the seed upserts on, e.g. `thyroid`. Ids are free to change, this is not.
  code        String          @unique
  title       String
  /// Optional intro paragraph above the service list — the app hides it when empty.
  description String?
  /// Price in tenge.
  price       Int
  /// How long the program runs, e.g. "1 день". Hidden by the app when unknown.
  duration    String?
  coverage    CheckupCoverage @default(PERSONAL)
  /// What the program includes, rendered as a checklist in the details drawer.
  services    String[]
  popular     Boolean         @default(false)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

/// Where an operator has got to with a paid-programs order.
enum ProgramOrderStatus {
  /// Paid, nobody has picked it up yet.
  NEW
  /// An operator is working it — the patient has been contacted, a date is being agreed.
  IN_PROGRESS
  /// The program has been issued / the check-up has taken place.
  COMPLETED
  CANCELLED
}

/// Which catalogue an ordered program came from. Mirrors the mobile app's two tabs.
enum ProgramOrderCategory {
  /// Med plan proxied from the MIS (`GET /insurance/pay-programs`).
  MED_PLAN
  /// Our own check-up catalogue (`Checkup`).
  CHECKUP
}

/// A paid-programs order ("заявка"): what the patient bought from the paid-programs
/// screen, recorded once the payment behind it settles as SUCCESS.
///
/// Created by the `PAID_PROGRAM` payment purpose handler, never by a request from the
/// app — an order exists only if the money moved. `paymentId` is unique, which is what
/// makes the handler idempotent: a replayed provider callback cannot duplicate the order.
model ProgramOrder {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  /// The settled payment this order was paid by — one order per payment.
  paymentId    String             @unique @db.Uuid
  status       ProgramOrderStatus @default(NEW)
  /// Amount actually paid, in tenge. Kept here so the order reads on its own.
  total        Float
  /// Phone to call the patient back on, copied from the account at order time.
  contactPhone String?
  /// Free-form note an operator leaves while working the order.
  comment      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  items   ProgramOrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// One program inside an order, snapshotted at purchase time — titles and prices in the
/// catalogue keep changing, an order must not.
model ProgramOrderItem {
  id         String               @id @default(uuid()) @db.Uuid
  orderId    String               @db.Uuid
  category   ProgramOrderCategory
  /// Catalogue id at purchase time: the MIS `oid` for a med plan, `Checkup.id` for a check-up.
  externalId String
  /// Catalogue code, e.g. `M2` for a med plan or the `thyroid` slug for a check-up.
  code       String?
  title      String
  /// Price in tenge at purchase time.
  price      Float

  order ProgramOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
